{
    "name": "networkrailbusinesssystems/bravo-api",
    "description": "Package to send and retrieve data from the Bravo rest API",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NetworkRailBusinessSystems\\BravoApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NetworkRailBusinessSystems\\BravoApi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Chris Rhymes",
            "email": "christopher.rhymes@networkrail.co.uk"
        },
        {
            "name": "Chris Abey",
            "email": "christopher.abey@networkrail.co.uk"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NetworkRailBusinessSystems\\BravoApi\\BravoApiServiceProvider"
            ],
            "aliases": []
        }
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7",
        "spatie/data-transfer-object": "^3",
        "spatie/enum": "^3"
    },
    "require-dev": {
        "orchestra/testbench": "^11",
        "larastan/larastan": "^3",
        "laravel/pint": "^1",
        "brianium/paratest": "^7",
        "networkrailbusinesssystems/badges": "^1",
        "phpunit/phpunit": "^12"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/phpunit"
    }
}
