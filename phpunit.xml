<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="vendor/autoload.php" backupGlobals="false" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <coverage>
    <report>
      <text outputFile=".phpunit.cache/coverage.txt" showUncoveredFiles="false" showOnlySummary="true" />
      <html outputDirectory=".phpunit.cache/html" />
    </report>
  </coverage>
  <logging>
    <junit outputFile=".phpunit.cache/tests.xml" />
  </logging>
  <testsuites>
    <testsuite name="FIQL Test Suite">
      <directory suffix="Test.php">tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="DB_CONNECTION" value="testing"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="BRAVO_API_USERNAME" value="test"/>
    <env name="BRAVO_API_PASSWORD" value="testing"/>
    <env name="BRAVO_API_BASE_URL" value="http://bravo.test"/>
    <env name="BRAVO_API_PROXY_ADDRESS" value="proxy.address"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">src/</directory>
    </include>
  </source>
</phpunit>
